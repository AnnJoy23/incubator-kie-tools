{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:recommended", "group:monorepos"],

  "forkProcessing": "enabled",
  "baseBranchPatterns": ["main"],
  "rebaseWhen": "behind-base-branch",

  "timezone": "Asia/Kolkata",
  "schedule": ["before 6am"],

  "dependencyDashboard": {
    "enabled": true,
    "title": "Dependency Updates Dashboard",
    "osvVulnerabilitySummary": "all"
  },
  "dependencyDashboardApproval": false,

  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "separateMultipleMajor": true,

  "automerge": false,
  "platformAutomerge": false,
  "labels": ["dependencies"],
  "addLabels": ["kie-tools"],
  "prBodyNotes": [
    "Related repos: incubator-kie, incubator-kie-tools, incubator-kie-kogito-examples. Check whether the same dependency needs the same update in the other two."
  ],

  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/__fixtures__/**"
  ],
  "postUpdateOptions": ["pnpmDedupe", "gomodTidy"],

  "packageRules": [
    {
      "description": "One combined daily PR for all minor and patch updates, every ecosystem",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    },
    {
      "description": "Major updates get their own PRs",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "description": "Quarkus family moves together on major upgrades",
      "matchPackageNames": ["io.quarkus:**", "io.quarkus.platform:**", "io.quarkiverse:**"],
      "matchUpdateTypes": ["major"],
      "groupName": "Quarkus major",
      "groupSlug": "quarkus-major"
    },
    {
      "description": "Spring Boot and Spring Framework move together on major upgrades",
      "matchPackageNames": ["org.springframework.boot:**", "org.springframework:**"],
      "matchUpdateTypes": ["major"],
      "groupName": "Spring major",
      "groupSlug": "spring-major"
    },
    {
      "description": "KIE jars consumed by the tools move together on major upgrades",
      "matchPackageNames": ["org.kie:**", "org.kie.kogito:**", "org.drools:**", "org.jbpm:**", "org.optaplanner:**"],
      "matchUpdateTypes": ["major"],
      "groupName": "KIE platform major",
      "groupSlug": "kie-platform-major"
    },
    {
      "description": "Webpack toolchain majors together",
      "matchManagers": ["npm"],
      "matchPackageNames": ["webpack", "webpack-cli", "webpack-dev-server", "webpack-merge", "/-loader$/"],
      "matchUpdateTypes": ["major"],
      "groupName": "webpack toolchain major",
      "groupSlug": "webpack-major"
    },
    {
      "description": "React and its type packages move together on major upgrades",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "matchUpdateTypes": ["major"],
      "groupName": "React major",
      "groupSlug": "react-major"
    },
    {
      "description": "@types/vscode must not exceed engines.vscode: listed in the dashboard, no PR until approved",
      "matchPackageNames": ["@types/vscode"],
      "dependencyDashboardApproval": true
    }
  ],

  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false
  }
}
